{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Classflow classroom: private files, grading, Excel, teacher-student conversations and optional Google sign-in.",
  "Parameters": {
    "GoogleClientId": {"Type": "String", "Default": ""},
    "GoogleClientSecret": {"Type": "String", "Default": "", "NoEcho": true}
  },
  "Conditions": {
    "HasGoogleAuth": {"Fn::And": [
      {"Fn::Not": [{"Fn::Equals": [{"Ref": "GoogleClientId"}, ""]}]},
      {"Fn::Not": [{"Fn::Equals": [{"Ref": "GoogleClientSecret"}, ""]}]}
    ]}
  },
  "Resources": {
    "WebBucket": {"Type": "AWS::S3::Bucket", "Properties": {"PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true}, "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]}}},
    "UploadsBucket": {"Type": "AWS::S3::Bucket", "Properties": {"PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true}, "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]}, "CorsConfiguration": {"CorsRules": [{"AllowedOrigins": [{"Fn::Sub": "https://${Distribution.DomainName}"}], "AllowedMethods": ["POST", "GET", "HEAD"], "AllowedHeaders": ["*"], "MaxAge": 300}]}, "LifecycleConfiguration": {"Rules": [{"Id": "AbortIncompleteMultipart", "Status": "Enabled", "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 1}}]}}},
    "DataTable": {"Type": "AWS::DynamoDB::Table", "Properties": {"BillingMode": "PAY_PER_REQUEST", "AttributeDefinitions": [{"AttributeName": "PK", "AttributeType": "S"}, {"AttributeName": "SK", "AttributeType": "S"}], "KeySchema": [{"AttributeName": "PK", "KeyType": "HASH"}, {"AttributeName": "SK", "KeyType": "RANGE"}], "SSESpecification": {"SSEEnabled": true}}},
    "UserPool": {"Type": "AWS::Cognito::UserPool", "Properties": {"UserPoolName": {"Fn::Sub": "${AWS::StackName}-users"}, "UserPoolTier": "ESSENTIALS", "UsernameAttributes": ["email"], "AutoVerifiedAttributes": ["email"], "LambdaConfig": {"PreSignUp": {"Fn::GetAtt": ["CognitoTriggerFunction", "Arn"]}}, "Schema": [{"Name": "name", "AttributeDataType": "String", "Required": true, "Mutable": true}], "Policies": {"PasswordPolicy": {"MinimumLength": 8, "RequireLowercase": true, "RequireNumbers": true, "RequireSymbols": false, "RequireUppercase": false}}, "AccountRecoverySetting": {"RecoveryMechanisms": [{"Name": "verified_email", "Priority": 1}]}}},
    "UserPoolDomain": {"Type": "AWS::Cognito::UserPoolDomain", "Properties": {"Domain": {"Fn::Sub": "classflow-${AWS::AccountId}"}, "ManagedLoginVersion": 2, "UserPoolId": {"Ref": "UserPool"}}},
    "GoogleIdentityProvider": {"Type": "AWS::Cognito::UserPoolIdentityProvider", "Condition": "HasGoogleAuth", "Properties": {"ProviderName": "Google", "ProviderType": "Google", "UserPoolId": {"Ref": "UserPool"}, "ProviderDetails": {"client_id": {"Ref": "GoogleClientId"}, "client_secret": {"Ref": "GoogleClientSecret"}, "authorize_scopes": "openid email profile"}, "AttributeMapping": {"email": "email", "email_verified": "email_verified", "name": "name"}}},
    "UserPoolClient": {"Type": "AWS::Cognito::UserPoolClient", "Properties": {"UserPoolId": {"Ref": "UserPool"}, "GenerateSecret": false, "ExplicitAuthFlows": ["ALLOW_USER_PASSWORD_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"], "PreventUserExistenceErrors": "ENABLED", "EnableTokenRevocation": true, "ReadAttributes": ["email", "email_verified", "name"], "WriteAttributes": ["email", "name"]}},
    "GoogleUserPoolClient": {"Type": "AWS::Cognito::UserPoolClient", "Condition": "HasGoogleAuth", "DependsOn": ["GoogleIdentityProvider"], "Properties": {"UserPoolId": {"Ref": "UserPool"}, "GenerateSecret": false, "ExplicitAuthFlows": ["ALLOW_USER_PASSWORD_AUTH", "ALLOW_REFRESH_TOKEN_AUTH"], "PreventUserExistenceErrors": "ENABLED", "EnableTokenRevocation": true, "ReadAttributes": ["email", "email_verified", "name"], "WriteAttributes": ["email", "name"], "SupportedIdentityProviders": ["COGNITO", "Google"], "AllowedOAuthFlowsUserPoolClient": true, "AllowedOAuthFlows": ["code"], "AllowedOAuthScopes": ["openid", "email", "profile"], "CallbackURLs": [{"Fn::Sub": "https://${Distribution.DomainName}/"}, "http://localhost:5173/", "http://127.0.0.1:5173/"], "LogoutURLs": [{"Fn::Sub": "https://${Distribution.DomainName}/"}, "http://localhost:5173/", "http://127.0.0.1:5173/"], "AccessTokenValidity": 1, "IdTokenValidity": 1, "RefreshTokenValidity": 7, "TokenValidityUnits": {"AccessToken": "hours", "IdToken": "hours", "RefreshToken": "days"}}},
    "GoogleLoginBranding": {"Type": "AWS::Cognito::ManagedLoginBranding", "Condition": "HasGoogleAuth", "DependsOn": "UserPoolDomain", "Properties": {"UserPoolId": {"Ref": "UserPool"}, "ClientId": {"Ref": "GoogleUserPoolClient"}, "UseCognitoProvidedValues": true}},
    "TeacherGroup": {"Type": "AWS::Cognito::UserPoolGroup", "Properties": {"UserPoolId": {"Ref": "UserPool"}, "GroupName": "teachers", "Description": "Only Classflow admins can assign teacher access"}},
    "AdminGroup": {"Type": "AWS::Cognito::UserPoolGroup", "Properties": {"UserPoolId": {"Ref": "UserPool"}, "GroupName": "admins", "Description": "Classflow system administrators"}},
    "CognitoTriggerRole": {"Type": "AWS::IAM::Role", "Properties": {"AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "Policies": [{"PolicyName": "LinkGoogleProfiles", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "*"}, {"Effect": "Allow", "Action": ["cognito-idp:ListUsers", "cognito-idp:AdminLinkProviderForUser"], "Resource": "*"}]}}]}},
    "CognitoTriggerFunction": {"Type": "AWS::Lambda::Function", "Properties": {"FunctionName": {"Fn::Sub": "${AWS::StackName}-cognito-link"}, "Runtime": "python3.13", "Handler": "index.lambda_handler", "Architectures": ["arm64"], "MemorySize": 128, "Timeout": 5, "Role": {"Fn::GetAtt": ["CognitoTriggerRole", "Arn"]}, "Code": {"ZipFile": "REPLACED_BY_PACKAGE_SCRIPT"}}},
    "CognitoTriggerPermission": {"Type": "AWS::Lambda::Permission", "Properties": {"Action": "lambda:InvokeFunction", "FunctionName": {"Ref": "CognitoTriggerFunction"}, "Principal": "cognito-idp.amazonaws.com", "SourceArn": {"Fn::GetAtt": ["UserPool", "Arn"]}}},
    "OriginAccess": {"Type": "AWS::CloudFront::OriginAccessControl", "Properties": {"OriginAccessControlConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-web"}, "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"}}},
    "WebCache": {"Type": "AWS::CloudFront::CachePolicy", "Properties": {"CachePolicyConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-cache"}, "DefaultTTL": 3600, "MaxTTL": 31536000, "MinTTL": 0, "ParametersInCacheKeyAndForwardedToOrigin": {"EnableAcceptEncodingGzip": true, "EnableAcceptEncodingBrotli": true, "CookiesConfig": {"CookieBehavior": "none"}, "HeadersConfig": {"HeaderBehavior": "none"}, "QueryStringsConfig": {"QueryStringBehavior": "none"}}}}},
    "WebHeaders": {"Type": "AWS::CloudFront::ResponseHeadersPolicy", "Properties": {"ResponseHeadersPolicyConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-security"}, "SecurityHeadersConfig": {"ContentTypeOptions": {"Override": true}, "FrameOptions": {"FrameOption": "DENY", "Override": true}, "ReferrerPolicy": {"ReferrerPolicy": "no-referrer", "Override": true}, "StrictTransportSecurity": {"AccessControlMaxAgeSec": 31536000, "IncludeSubdomains": true, "Override": true}, "ContentSecurityPolicy": {"ContentSecurityPolicy": {"Fn::Sub": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.amazonaws.com https://*.auth.${AWS::Region}.amazoncognito.com; img-src 'self' data: blob: https://*.s3.${AWS::Region}.${AWS::URLSuffix}; frame-src 'self' blob: https://*.s3.${AWS::Region}.${AWS::URLSuffix}; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}, "Override": true}}}}},
    "Distribution": {"Type": "AWS::CloudFront::Distribution", "Properties": {"DistributionConfig": {"Enabled": true, "DefaultRootObject": "index.html", "HttpVersion": "http2and3", "PriceClass": "PriceClass_200", "Origins": [{"Id": "web", "DomainName": {"Fn::GetAtt": ["WebBucket", "RegionalDomainName"]}, "OriginAccessControlId": {"Ref": "OriginAccess"}, "S3OriginConfig": {"OriginAccessIdentity": ""}}], "DefaultCacheBehavior": {"TargetOriginId": "web", "ViewerProtocolPolicy": "redirect-to-https", "AllowedMethods": ["GET", "HEAD"], "CachedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": {"Ref": "WebCache"}, "ResponseHeadersPolicyId": {"Ref": "WebHeaders"}}, "ViewerCertificate": {"CloudFrontDefaultCertificate": true}}}},
    "WebPolicy": {"Type": "AWS::S3::BucketPolicy", "Properties": {"Bucket": {"Ref": "WebBucket"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "cloudfront.amazonaws.com"}, "Action": "s3:GetObject", "Resource": {"Fn::Sub": "${WebBucket.Arn}/*"}, "Condition": {"StringEquals": {"AWS:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}}}]}}},
    "ApiLogs": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/aws/lambda/${AWS::StackName}-api"}, "RetentionInDays": 7}},
    "ApiRole": {"Type": "AWS::IAM::Role", "Properties": {"AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "Policies": [{"PolicyName": "ClassroomDataOnly", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::GetAtt": ["ApiLogs", "Arn"]}}, {"Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query"], "Resource": {"Fn::GetAtt": ["DataTable", "Arn"]}}, {"Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"], "Resource": {"Fn::Sub": "${UploadsBucket.Arn}/*"}}, {"Effect": "Allow", "Action": ["cognito-idp:ListUsers", "cognito-idp:AdminGetUser", "cognito-idp:AdminCreateUser", "cognito-idp:AdminSetUserPassword", "cognito-idp:AdminAddUserToGroup", "cognito-idp:AdminRemoveUserFromGroup", "cognito-idp:AdminListGroupsForUser"], "Resource": {"Fn::GetAtt": ["UserPool", "Arn"]}}]}}]}},
    "ApiFunction": {"Type": "AWS::Lambda::Function", "DependsOn": "ApiLogs", "Properties": {"FunctionName": {"Fn::Sub": "${AWS::StackName}-api"}, "Runtime": "python3.13", "Handler": "index.lambda_handler", "Architectures": ["arm64"], "MemorySize": 256, "Timeout": 60, "Role": {"Fn::GetAtt": ["ApiRole", "Arn"]}, "Environment": {"Variables": {"TABLE_NAME": {"Ref": "DataTable"}, "UPLOAD_BUCKET": {"Ref": "UploadsBucket"}, "USER_POOL_ID": {"Ref": "UserPool"}}}, "Code": {"ZipFile": "REPLACED_BY_PACKAGE_SCRIPT"}}},
    "HttpApi": {"Type": "AWS::ApiGatewayV2::Api", "Properties": {"Name": {"Fn::Sub": "${AWS::StackName}-http"}, "ProtocolType": "HTTP", "CorsConfiguration": {"AllowOrigins": [{"Fn::Sub": "https://${Distribution.DomainName}"}], "AllowMethods": ["POST", "OPTIONS"], "AllowHeaders": ["authorization", "content-type"], "MaxAge": 300}}},
    "JwtAuthorizer": {"Type": "AWS::ApiGatewayV2::Authorizer", "Properties": {"ApiId": {"Ref": "HttpApi"}, "AuthorizerType": "JWT", "Name": "CognitoClassroomUsers", "IdentitySource": ["$request.header.Authorization"], "JwtConfiguration": {"Audience": [{"Fn::If": ["HasGoogleAuth", {"Ref": "GoogleUserPoolClient"}, {"Ref": "UserPoolClient"}]}], "Issuer": {"Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${UserPool}"}}}},
    "ApiIntegration": {"Type": "AWS::ApiGatewayV2::Integration", "Properties": {"ApiId": {"Ref": "HttpApi"}, "IntegrationType": "AWS_PROXY", "IntegrationUri": {"Fn::GetAtt": ["ApiFunction", "Arn"]}, "PayloadFormatVersion": "2.0"}},
    "ApiRoute": {"Type": "AWS::ApiGatewayV2::Route", "Properties": {"ApiId": {"Ref": "HttpApi"}, "RouteKey": "POST /rpc", "AuthorizationType": "JWT", "AuthorizerId": {"Ref": "JwtAuthorizer"}, "Target": {"Fn::Sub": "integrations/${ApiIntegration}"}}},
    "ApiStage": {"Type": "AWS::ApiGatewayV2::Stage", "Properties": {"ApiId": {"Ref": "HttpApi"}, "StageName": "$default", "AutoDeploy": true, "DefaultRouteSettings": {"ThrottlingBurstLimit": 20, "ThrottlingRateLimit": 10}}},
    "ApiPermission": {"Type": "AWS::Lambda::Permission", "Properties": {"Action": "lambda:InvokeFunction", "Principal": "apigateway.amazonaws.com", "FunctionName": {"Ref": "ApiFunction"}, "SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/POST/rpc"}}},
    "AssetLogs": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/aws/lambda/${AWS::StackName}-assets"}, "RetentionInDays": 7}},
    "AssetRole": {"Type": "AWS::IAM::Role", "Properties": {"AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "Policies": [{"PolicyName": "PublishStaticWebsiteOnly", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["s3:PutObject"], "Resource": {"Fn::Sub": "${WebBucket.Arn}/*"}}, {"Effect": "Allow", "Action": ["cloudfront:CreateInvalidation"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}, {"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::GetAtt": ["AssetLogs", "Arn"]}}]}}]}},
    "AssetFunction": {"Type": "AWS::Lambda::Function", "DependsOn": "AssetLogs", "Properties": {"FunctionName": {"Fn::Sub": "${AWS::StackName}-assets"}, "Runtime": "python3.13", "Handler": "index.lambda_handler", "Architectures": ["arm64"], "MemorySize": 256, "Timeout": 90, "Role": {"Fn::GetAtt": ["AssetRole", "Arn"]}, "Code": {"ZipFile": "REPLACED_BY_PACKAGE_SCRIPT"}}},
    "SiteAssets": {"Type": "Custom::ClassroomFrontend", "DependsOn": ["WebPolicy", "ApiRoute", "ApiStage"], "Properties": {"ServiceToken": {"Fn::GetAtt": ["AssetFunction", "Arn"]}, "Bucket": {"Ref": "WebBucket"}, "Distribution": {"Ref": "Distribution"}, "Bundle": "REPLACED_BY_PACKAGE_SCRIPT", "Config": {"region": {"Ref": "AWS::Region"}, "userPoolId": {"Ref": "UserPool"}, "clientId": {"Fn::If": ["HasGoogleAuth", {"Ref": "GoogleUserPoolClient"}, {"Ref": "UserPoolClient"}]}, "apiUrl": {"Fn::GetAtt": ["HttpApi", "ApiEndpoint"]}, "cognitoDomain": {"Fn::Sub": "https://${UserPoolDomain}.auth.${AWS::Region}.amazoncognito.com"}, "googleEnabled": {"Fn::If": ["HasGoogleAuth", true, false]}}}}
  },
  "Outputs": {
    "WebsiteUrl": {"Value": {"Fn::Sub": "https://${Distribution.DomainName}"}},
    "FrontendBucket": {"Value": {"Ref": "WebBucket"}},
    "UploadsBucket": {"Value": {"Ref": "UploadsBucket"}},
    "DistributionId": {"Value": {"Ref": "Distribution"}},
    "ApiUrl": {"Value": {"Fn::GetAtt": ["HttpApi", "ApiEndpoint"]}},
    "UserPoolId": {"Value": {"Ref": "UserPool"}},
    "ClientId": {"Value": {"Fn::If": ["HasGoogleAuth", {"Ref": "GoogleUserPoolClient"}, {"Ref": "UserPoolClient"}]}},
    "CognitoDomain": {"Value": {"Fn::Sub": "https://${UserPoolDomain}.auth.${AWS::Region}.amazoncognito.com"}},
    "GoogleAuthEnabled": {"Value": {"Fn::If": ["HasGoogleAuth", "true", "false"]}},
    "Region": {"Value": {"Ref": "AWS::Region"}},
    "TableName": {"Value": {"Ref": "DataTable"}}
  }
}
